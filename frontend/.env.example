# Copy to frontend/.env for local development. Vite exposes only VITE_* variables to the browser,
# so never put secrets here.

# Backend API base URL
VITE_API_URL=http://localhost:3000

# Optional onboarding video shown in the app
VITE_ONBOARDING_VIDEO_URL=

# Google Maps Embed API key used by the Map block.
# Restrict it in Google Cloud Console (HTTP referrers: your domains, API: Maps Embed API only).
# Leave empty to fall back to the keyless Google Maps embed.
VITE_GOOGLE_MAPS_EMBED_KEY=
